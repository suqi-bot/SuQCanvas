# Supabase 配置（可选，不配置则应用运行在纯本地模式）
# 1. 在 https://supabase.com 创建项目
# 2. 在 SQL Editor 中执行 supabase/schema.sql（建表 + RLS 策略）
# 3. 复制 Project Settings -> API 中的 URL 和 anon public key 填入下面两行
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 局域网中继地址（可选；默认使用当前站点的 /lan-ws 反向代理）
# HTTPS 站点必须使用 wss://，例如 wss://canvas.example.com/lan-ws
VITE_LAN_WS_URL=

# ============================================================
# 阿里云 OSS 配置（可选，不配置则媒体文件仅存本地 IndexedDB）
# ============================================================
# Bucket 所在地域，如 oss-cn-hangzhou
VITE_OSS_REGION=oss-cn-hangzhou
# Bucket 名称
VITE_OSS_BUCKET=your-bucket
# 开发模式：RAM 子账号 AccessKey（仅限本地测试，不要上生产！）
# 生产模式：改用下面的 STS URL 由服务端签发临时凭证，无需配置 AK
VITE_OSS_ACCESS_KEY_ID=
VITE_OSS_ACCESS_KEY_SECRET=
# 生产模式：返回 JSON { accessKeyId, accessKeySecret, securityToken } 的 STS 接口
VITE_OSS_STS_URL=
