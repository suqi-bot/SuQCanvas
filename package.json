{
  "name": "suqcanvas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "vite",
    "dev:lan": "vite --mode lan --host 0.0.0.0",
    "predev:lan": "node scripts/copy-pdfjs-assets.mjs",
    "build": "tsc -b && node scripts/build.mjs",
    "build:online": "tsc -b && node scripts/build.mjs online",
    "build:lan": "tsc -b && node scripts/build.mjs lan",
    "package:lan": "npm run build:lan && node scripts/package-lan.mjs",
    "build:all": "tsc -b && node scripts/build.mjs all",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "lan": "node server/lan-server.mjs",
    "lan:open": "powershell -ExecutionPolicy Bypass -File scripts/open-lan-firewall.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@xyflow/react": "^12.11.3",
    "ag-psd": "^31.0.2",
    "ali-oss": "^6.23.0",
    "dexie": "^4.4.5",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
